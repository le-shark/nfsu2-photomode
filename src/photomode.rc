#include <winver.h>
#include "version.h"
#include "watermark_res.h"

// Built-in watermarks (user 2026-10-20): everything ships inside the ASI.
IDR_WM_NFSPLANET RCDATA "nfsplanet_watermark.png"
IDR_WM_NFS RCDATA "nfs.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PHOTOMODE_VERSION_NUM
PRODUCTVERSION PHOTOMODE_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "NFSU2 Photo Mode (ASI plugin for Need for Speed Underground 2 v1.2)"
      VALUE "FileVersion", PHOTOMODE_VERSION
      VALUE "ProductName", "NFSU2 Photo Mode"
      VALUE "ProductVersion", PHOTOMODE_VERSION
      VALUE "OriginalFilename", "NFSU2PhotoMode.asi"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
